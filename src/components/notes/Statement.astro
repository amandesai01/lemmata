---
// A definition, result or example. Its head runs into the first paragraph: THEOREM 3.3 (Lagrange).
// Results are stated in italic; definitions and examples are set in roman.
import { statementId, type StatementKind } from './statements';

interface Props {
  kind: StatementKind;
  /** The number in the head, as written: "3.3". */
  n: string;
  /** An optional name, set in roman after the head: "Lagrange". */
  name?: string;
  /** Required. What the statement is, shown under its label in the statements rail: "Lagrange’s theorem".
      May use *variables* and <sub>/<sup>. Not set on the page itself. */
  title: string;
}

const { kind, n, name } = Astro.props;
const italic = kind !== 'Definition' && kind !== 'Example';
const id = statementId(kind, n);
---

<!-- The head links to the statement itself, as a contents entry links to its section. -->
<div id={id} class:list={['env', { result: italic }]}>
  <a class="env-head" href={`#${id}`}>{kind} {n}</a>{name && <span class="env-name">({name}).</span>}
  <slot />
</div>
