---
// The video a section follows. Chosen, it plays in a full-screen view on the page (VideoView.astro),
// which loads nothing from YouTube until then. It is still a link to the video on YouTube, so a
// modified click, or a page without scripts, opens it there.
// Its play mark hangs in the margin column, as a section numeral does.
interface Props {
  /** The YouTube video id: the v= of its watch URL. */
  id: string;
  /** What the video is about, with no channel, presenter or series names: "Cosets and Lagrange’s theorem". */
  title: string;
  /** Its running time as YouTube shows it: "48:12". */
  duration?: string;
}

const { id, title, duration } = Astro.props;
const href = `https://www.youtube.com/watch?v=${encodeURIComponent(id)}`;
---

<a class="video" href={href} data-video={id} data-video-title={title} data-video-duration={duration} aria-haspopup="dialog">
  <svg class="video-mark" viewBox="0 0 12 12" aria-hidden="true"><polygon points="1,0.5 11.5,6 1,11.5" /></svg>
  <span class="video-title">{title}</span>
  <span class="video-meta">Watch{duration && <span class="video-time"> · {duration}</span>}</span>
</a>
