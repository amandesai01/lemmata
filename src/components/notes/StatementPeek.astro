---
// A quick look at a statement without leaving your place. Any link marked data-statement="<id>"
// opens it, showing the statement as set on the page, with a link to go there.
---

<dialog class="peek" closedby="any" autofocus>
  <div class="peek-body">
    <div class="prose" data-peek-content></div>
    <p class="peek-actions">
      <a href="#" data-peek-go>Go to <span data-peek-label></span></a>
      <button type="button" data-peek-close>Close</button>
    </p>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('dialog.peek')!;
  const content = dialog.querySelector<HTMLElement>('[data-peek-content]')!;
  const go = dialog.querySelector<HTMLAnchorElement>('[data-peek-go]')!;
  const label = dialog.querySelector<HTMLElement>('[data-peek-label]')!;

  document.addEventListener('click', (e) => {
    if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    const link = (e.target as Element).closest<HTMLAnchorElement>('a[data-statement]');
    const statement = link && document.getElementById(link.dataset.statement!);
    if (!statement) return;
    e.preventDefault();

    // The statement as set on the page, without its ids, so nothing on the page is duplicated.
    const copy = statement.cloneNode(true) as HTMLElement;
    [copy, ...copy.querySelectorAll('[id]')].forEach((el) => el.removeAttribute('id'));
    content.replaceChildren(copy);

    const head = statement.querySelector('.env-head')?.textContent ?? '';
    label.textContent = head;
    dialog.setAttribute('aria-label', head);
    go.href = `#${statement.id}`;
    dialog.showModal();
  });

  // Close first, then let the link scroll to the statement. The same for any link inside the
  // statement shown (its own head, a reference to Fig. 1), which would otherwise move the page unseen.
  go.addEventListener('click', () => dialog.close());
  content.addEventListener('click', (e) => {
    if ((e.target as Element).closest('a[href^="#"]')) dialog.close();
  });
  dialog.querySelector('[data-peek-close]')!.addEventListener('click', () => dialog.close());
  // Clicking outside the text closes it, where closedby="any" is not supported.
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>

<style>
  /* A sheet lifted off the page: square, on the same paper, held up by a soft shadow in lamp-black
     ink while the page behind blurs a little and pales. The one place the notes leave the flat plate. */
  .peek {
    width: min(40rem, calc(100vw - 2rem));
    max-width: none;
    max-height: calc(100svh - 4rem);
    padding: 0;
    border: 0;
    background: var(--paper);
    color: var(--ink);
    overflow-y: auto;
    overscroll-behavior: contain;
    box-shadow:
      0 1px 2px rgb(20 20 20 / 0.06),
      0 6px 16px -4px rgb(20 20 20 / 0.08),
      0 24px 56px -12px rgb(20 20 20 / 0.16);
  }

  /* The dialog takes focus itself when it opens, so no control is ringed before it is chosen. */
  .peek:focus { outline: none; }

  .peek::backdrop {
    background: rgb(252 252 250 / 0.72);
    backdrop-filter: blur(3px);
  }

  .peek-body { padding: clamp(1.5rem, 4vw, 2.5rem) clamp(1rem, 4vw, 2.5rem); }

  .peek :global(.prose) { max-width: none; }
  .peek :global(.prose > .env) { margin-top: 0; }

  .peek-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem 1.75rem;
    margin-top: 1.75rem;
    font-size: 1rem;
  }

  .peek-actions a {
    color: var(--blue);
    text-decoration-color: var(--blue);
  }

  .peek-actions a:hover { color: var(--red); text-decoration-color: var(--red); }

  .peek-actions button {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 0.8125rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
    cursor: pointer;
  }

  .peek-actions button:hover { color: var(--red); }

  /* Opening, the sheet rises a little and settles as its shadow deepens, and the statement inks in
     just after it; closing, it sinks back quickly. Transitions rather than keyframes, so closing
     animates too: display and overlay are held until the sheet has gone. */
  @media (prefers-reduced-motion: no-preference) {
    /* Closing: the house curve spends itself in the first frames, which reads as a snap, so the
       exit accelerates away instead. */
    .peek {
      opacity: 0;
      transform: translateY(10px) scale(0.98);
      transition:
        opacity 200ms cubic-bezier(0.4, 0, 1, 1),
        transform 200ms cubic-bezier(0.4, 0, 1, 1),
        overlay 200ms allow-discrete,
        display 200ms allow-discrete;
    }

    .peek[open] {
      opacity: 1;
      transform: none;
      transition-duration: 420ms;
      transition-timing-function: var(--ease-out);
    }

    .peek::backdrop {
      opacity: 0;
      transition:
        opacity 200ms cubic-bezier(0.4, 0, 1, 1),
        overlay 200ms allow-discrete,
        display 200ms allow-discrete;
    }

    .peek[open]::backdrop {
      opacity: 1;
      transition-duration: 320ms;
      transition-timing-function: var(--ease-out);
    }

    .peek[open] .peek-body > * {
      transition: opacity 360ms var(--ease-out) 90ms, transform 360ms var(--ease-out) 90ms;
    }

    .peek[open] .peek-body > :last-child { transition-delay: 150ms; }

    @starting-style {
      .peek[open] {
        opacity: 0;
        transform: translateY(14px) scale(0.97);
      }

      .peek[open]::backdrop { opacity: 0; }

      .peek[open] .peek-body > * {
        opacity: 0;
        transform: translateY(6px);
      }
    }
  }

  /* With reduced motion the sheet only fades. */
  @media (prefers-reduced-motion: reduce) {
    .peek,
    .peek::backdrop {
      opacity: 0;
      transition: opacity 120ms linear, overlay 120ms allow-discrete, display 120ms allow-discrete;
    }

    .peek[open],
    .peek[open]::backdrop { opacity: 1; }

    @starting-style {
      .peek[open],
      .peek[open]::backdrop { opacity: 0; }
    }
  }
</style>
