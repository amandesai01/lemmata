---
// Solving questions without distraction. The SOLVE control on a <Questions> card opens a plain page
// over the notes with that section's questions, one at a time; the control above the contents opens
// every question on the page, with a rail of the sections to their left. "Check your solution" opens a sheet that walks
// the reader through having an AI assistant check a photo of their written work: it copies a prompt
// holding the question, the statements it cites and the question's answer-ctx, so the assistant
// needs nothing else.
---

<dialog class="solve" aria-labelledby="solve-heading" autofocus>
  <div class="solve-frame">
    <header class="solve-top">
      <h2 id="solve-heading" class="solve-where">
        <span class="solve-label">Questions</span>
        <span class="solve-section"><span class="solve-section-n" data-solve-section-n></span><span data-solve-section-title></span></span>
      </h2>
      <button type="button" class="solve-label solve-close" data-solve-close>Close</button>
    </header>

    <div class="solve-body">
    <div class="solve-main">
      <div class="solve-question" data-solve-question>
        <span class="solve-n" data-solve-n></span>
        <div class="solve-text prose" data-solve-text></div>
      </div>
      <button type="button" class="solve-check" data-solve-check aria-haspopup="dialog">
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <path d="M1.5 4.75h3.25l1.25-2h4l1.25 2h3.25v8.5h-13z" />
          <circle cx="8" cy="8.75" r="2.6" />
        </svg>
        <span class="cap-text">Check your solution</span>
      </button>
    </div>

    <nav class="solve-sections" aria-labelledby="solve-sections-heading">
      <h3 id="solve-sections-heading" class="solve-sections-head">Sections</h3>
      <ol class="solve-sections-list" data-solve-sections></ol>
    </nav>
    </div>

    <nav class="solve-nav" aria-label="Questions in this section" data-solve-foot>
      <button type="button" class="solve-label solve-step" data-solve-prev>
        <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M7.5 2 3.5 6l4 4" /></svg>
        <span class="cap-text">Previous</span>
      </button>
      <ol class="solve-list" data-solve-list></ol>
      <button type="button" class="solve-label solve-step" data-solve-next>
        <span class="cap-text">Next</span>
        <svg viewBox="0 0 12 12" aria-hidden="true"><path d="m4.5 2 4 4-4 4" /></svg>
      </button>
    </nav>
  </div>
</dialog>

<dialog class="check sheet" closedby="any" aria-labelledby="check-heading" autofocus>
  <div class="check-body sheet-body">
    <h2 id="check-heading" class="check-heading">Check your solution</h2>
    <p class="check-lede">
      An AI assistant can read a photo of your written work and check it. The prompt carries
      Question <span data-check-n></span>, the statements it cites and what a complete answer must
      contain, so the assistant needs nothing else.
    </p>

    <ol class="check-steps">
      <li>
        <div>
          <p>Copy the prompt.</p>
          <button type="button" class="solve-check check-copy" data-check-copy>
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="M5.5 5.5h8v8.5h-8z" />
              <path d="M10.5 5.5V2h-8v8.5h3" />
            </svg>
            <span class="cap-text" data-check-copy-label>Copy prompt</span>
          </button>
          <p class="check-status" role="status" data-check-status></p>
        </div>
      </li>
      <li><p>Open an AI assistant, such as ChatGPT, Claude or Gemini, and start a new chat.</p></li>
      <li><p>Take a clear photo of your written solution and attach it to the message.</p></li>
      <li><p>Paste the prompt and send it.</p></li>
    </ol>

    <details class="check-prompt" data-check-details>
      <summary>
        <svg viewBox="0 0 12 12" aria-hidden="true"><path d="m4.5 2 4 4-4 4" /></svg>
        <span class="cap-text">Read the prompt</span>
      </summary>
      <pre data-check-prompt></pre>
    </details>

    <p class="check-actions">
      <button type="button" class="solve-label" data-check-close>Close</button>
    </p>
  </div>
</dialog>

<script>
  const solve = document.querySelector<HTMLDialogElement>('dialog.solve')!;
  const check = document.querySelector<HTMLDialogElement>('dialog.check')!;
  const $ = <T extends Element>(root: Element, attr: string) => root.querySelector<T>(`[${attr}]`)!;

  const sectionN = $<HTMLElement>(solve, 'data-solve-section-n');
  const sectionTitle = $<HTMLElement>(solve, 'data-solve-section-title');
  const questionBox = $<HTMLElement>(solve, 'data-solve-question');
  const numeral = $<HTMLElement>(solve, 'data-solve-n');
  const text = $<HTMLElement>(solve, 'data-solve-text');
  const list = $<HTMLOListElement>(solve, 'data-solve-list');
  const prev = $<HTMLButtonElement>(solve, 'data-solve-prev');
  const next = $<HTMLButtonElement>(solve, 'data-solve-next');

  const checkN = $<HTMLElement>(check, 'data-check-n');
  const copyButton = $<HTMLButtonElement>(check, 'data-check-copy');
  const copyLabel = $<HTMLElement>(check, 'data-check-copy-label');
  const status = $<HTMLElement>(check, 'data-check-status');
  const details = $<HTMLDetailsElement>(check, 'data-check-details');
  const promptBox = $<HTMLElement>(check, 'data-check-prompt');

  const still = matchMedia('(prefers-reduced-motion: reduce)');

  interface Section {
    n: string;
    title: string;
  }

  interface Question {
    n: string;
    item: HTMLLIElement;
    section: Section;
  }

  const sectionsList = $<HTMLOListElement>(solve, 'data-solve-sections');
  const foot = $<HTMLElement>(solve, 'data-solve-foot');

  let questions: Question[] = [];
  let at = 0;
  let shown: Section | null = null;
  let prompt = '';

  // ——— Opening the solving view ———

  document.addEventListener('click', (e) => {
    const target = e.target as Element;
    if (target.closest('[data-solve-all]')) {
      open([...document.querySelectorAll<HTMLElement>('.questions')].filter((card) => !solve.contains(card)), true);
      return;
    }
    const card = target.closest('[data-solve]')?.closest<HTMLElement>('.questions');
    if (card) open([card], false);
  });

  // A card's section is the nearest heading before it; its numeral is its place among the headings.
  function sectionOf(card: HTMLElement): Section {
    let heading = card.previousElementSibling;
    while (heading && heading.tagName !== 'H2') heading = heading.previousElementSibling;
    const headings = [...(card.parentElement?.querySelectorAll(':scope > h2') ?? [])];
    return { n: String(headings.indexOf(heading!) + 1), title: heading?.textContent?.trim() ?? '' };
  }

  const numeralButton = (q: Question, i: number) => {
    const b = document.createElement('button');
    b.type = 'button';
    b.textContent = q.n;
    b.dataset.q = String(i);
    b.setAttribute('aria-label', `Question ${q.n}`);
    b.addEventListener('click', () => show(i));
    return b;
  };

  function open(cards: HTMLElement[], all: boolean) {
    questions = cards.flatMap((card) => {
      const section = sectionOf(card);
      const items = [...card.querySelectorAll<HTMLLIElement>(':scope > ol > li.question')];
      return items.map((item, i) => ({ n: `${section.n}.${i + 1}`, item, section }));
    });
    if (!questions.length) return;

    solve.toggleAttribute('data-all', all);
    foot.setAttribute('aria-label', all ? 'Questions in the current section' : 'Questions in this section');

    // The rail: each section, which opens at its first question, and the numerals of its questions.
    const sections = [...new Set(questions.map((q) => q.section))];
    sectionsList.replaceChildren(
      ...(all ? sections : []).map((section) => {
        const li = document.createElement('li');
        li.className = 'solve-sec';
        const first = questions.findIndex((q) => q.section === section);
        const head = document.createElement('button');
        head.type = 'button';
        head.className = 'solve-sec-head';
        const n = document.createElement('span');
        n.className = 'solve-sec-n';
        n.textContent = section.n;
        const title = document.createElement('span');
        title.textContent = section.title;
        head.append(n, title);
        head.addEventListener('click', () => show(first));
        const ol = document.createElement('ol');
        questions.forEach((q, i) => {
          if (q.section !== section) return;
          const item = document.createElement('li');
          item.append(numeralButton(q, i));
          ol.append(item);
        });
        li.append(head, ol);
        return li;
      }),
    );

    shown = null;
    show(0, false);
    solve.showModal();
    revealSection();
  }

  // Entering a section that is not wholly in sight, the rail scrolls to bring its title to the top.
  function revealSection() {
    const sec = sectionsList.querySelector<HTMLElement>('.solve-sec.is-current');
    if (!sec) return;
    const list = sectionsList.getBoundingClientRect();
    const box = sec.getBoundingClientRect();
    if (box.top >= list.top && box.bottom <= list.bottom) return;
    const pad = parseFloat(getComputedStyle(sectionsList).paddingTop);
    sectionsList.scrollTo({ top: sectionsList.scrollTop + box.top - list.top - pad, behavior: still.matches ? 'auto' : 'smooth' });
  }

  let turn = 0;

  function show(i: number, animate = true) {
    if (i < 0 || i >= questions.length) return;
    at = i;
    const q = questions[i];

    // The controls answer at once; the question itself is changed over in show's own time. Moving
    // into another section changes the top line and the numerals along the foot.
    if (q.section !== shown) {
      shown = q.section;
      sectionN.textContent = q.section.n;
      sectionTitle.textContent = q.section.title;
      list.replaceChildren(
        ...questions.flatMap((other, j) => {
          if (other.section !== q.section) return [];
          const li = document.createElement('li');
          li.append(numeralButton(other, j));
          return [li];
        }),
      );
      sectionsList.querySelectorAll('.solve-sec').forEach((sec, k) => {
        sec.classList.toggle('is-current', [...new Set(questions.map((x) => x.section))][k] === q.section);
      });
      revealSection();
    }
    solve.querySelectorAll<HTMLButtonElement>('button[data-q]').forEach((b) => {
      if (b.dataset.q === String(i)) b.setAttribute('aria-current', 'step');
      else b.removeAttribute('aria-current');
    });
    prev.disabled = i === 0;
    next.disabled = i === questions.length - 1;

    const mine = ++turn;
    if (!animate || still.matches) {
      setQuestion(q);
      return;
    }

    // The question being left fades quickly, then the next inks in, as a page does. A newer choice
    // made meanwhile takes over from wherever the fade has reached.
    const from = getComputedStyle(questionBox).opacity;
    const out = questionBox.animate([{ opacity: from }, { opacity: 0 }], {
      duration: 140,
      easing: 'cubic-bezier(0.4, 0, 1, 1)',
      fill: 'forwards',
    });
    out.finished
      .then(() => {
        if (mine !== turn) {
          out.cancel();
          return;
        }
        setQuestion(q);
        questionBox.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 380, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' });
        out.cancel();
      })
      .catch(() => {});
  }

  function setQuestion(q: Question) {
    numeral.textContent = q.n;
    const copy = [...q.item.childNodes].map((node) => node.cloneNode(true));
    copy.forEach((node) => node instanceof Element && node.querySelectorAll('[id]').forEach((el) => el.removeAttribute('id')));
    text.replaceChildren(...copy);
    questionBox.setAttribute('aria-label', `Question ${q.n}`);
  }

  prev.addEventListener('click', () => show(at - 1));
  next.addEventListener('click', () => show(at + 1));
  $(solve, 'data-solve-close').addEventListener('click', () => solve.close());

  solve.addEventListener('keydown', (e) => {
    if (check.open || e.altKey || e.ctrlKey || e.metaKey) return;
    if (e.key === 'ArrowRight') show(at + 1);
    else if (e.key === 'ArrowLeft') show(at - 1);
  });

  // ——— The prompt ———

  // Plain text for an assistant: superscripts and subscripts become ^ and _, lists keep their
  // markers, and a statement keeps its head.
  const roman = ['i', 'ii', 'iii', 'iv', 'v', 'vi', 'vii', 'viii', 'ix', 'x'];
  const group = (s: string) => (/^[\p{L}\p{N}]$/u.test(s) ? s : `(${s})`);

  function plain(node: Node): string {
    if (node.nodeType === Node.TEXT_NODE) return (node.textContent ?? '').replace(/\s+/g, ' ');
    if (!(node instanceof HTMLElement)) return '';
    const inner = () => [...node.childNodes].map(plain).join('');
    switch (node.tagName) {
      case 'SUP':
        return `^${group(inner().trim())}`;
      case 'SUB':
        return `_${group(inner().trim())}`;
      case 'BR':
        return '\n';
      case 'OL':
        return `\n${[...node.children].map((li, i) => `(${roman[i] ?? i + 1}) ${tidy(plain(li))}`).join('\n')}\n`;
      case 'TR':
        return `\n${[...node.children].map((cell) => tidy(plain(cell)) || ' ').join(' | ')}`;
      case 'P':
      case 'DIV':
      case 'LI':
      case 'TABLE':
        return `\n${inner().trim()}\n`;
      default:
        return inner();
    }
  }

  const tidy = (s: string) =>
    s
      .split('\n')
      .map((line) => line.replace(/[ \t]+/g, ' ').trim())
      .join('\n')
      .replace(/\n{3,}/g, '\n\n')
      .trim();

  function statementText(el: HTMLElement) {
    const head = el.querySelector('.env-head')?.textContent?.trim() ?? '';
    const name = el.querySelector('.env-name')?.textContent?.trim();
    const body = el.cloneNode(true) as HTMLElement;
    body.querySelectorAll('.env-head, .env-name').forEach((n) => n.remove());
    return `${head}${name ? ` ${name}` : '.'} ${tidy(plain(body))}`;
  }

  function buildPrompt(q: Question) {
    const subject = document.querySelector('h1')?.textContent?.trim() ?? '';
    const question = tidy(plain(q.item));

    // Statements the question cites by number, set out in full so the assistant has them.
    const cited = [...question.matchAll(/\b(Definition|Example|Proposition|Lemma|Theorem|Corollary) (\d+\.\d+)/g)]
      .map(([, kind, n]) => document.getElementById(`${kind.toLowerCase()}-${n.replaceAll('.', '-')}`))
      .filter((el, i, all): el is HTMLElement => !!el && all.indexOf(el) === i)
      .map(statementText);

    return [
      `I am studying ${subject.toLowerCase()} on my own and have written a solution to the question below. A photo of my handwritten solution is attached.`,
      [
        'Please check my solution as a careful examiner would:',
        '- First say whether it is correct and complete.',
        '- If it is not, point to the first step that is wrong, unjustified or missing, quote it, and explain the problem.',
        '- Accept any valid approach, even one that differs from the checking notes below.',
        '- Do not write out a full solution, and do not reveal points I have not reached, unless I ask.',
        '- If part of the photo is hard to read, say which part instead of guessing.',
      ].join('\n'),
      `Subject: ${subject}\nSection ${q.section.n}: ${q.section.title}`,
      `Question ${q.n}\n${question}`,
      cited.length ? `Statements the question cites, as given in my notes:\n${cited.join('\n\n')}` : '',
      `Checking notes (for you; do not quote them back in full):\n${q.item.dataset.answerCtx ?? ''}`,
      'Notation: a product ab is the group operation applied to a and b; e is the identity; x^n is a power and x^(−1) an inverse; x_n is a subscript; ℤ, ℚ, ℝ and ℂ are the integers, rationals, reals and complex numbers.',
    ]
      .filter(Boolean)
      .join('\n\n');
  }

  // ——— The check sheet ———

  $(solve, 'data-solve-check').addEventListener('click', () => {
    const q = questions[at];
    prompt = buildPrompt(q);
    checkN.textContent = q.n;
    promptBox.textContent = prompt;
    copyLabel.textContent = 'Copy prompt';
    status.textContent = '';
    details.open = false;
    check.showModal();
  });

  async function copyText(value: string) {
    try {
      await navigator.clipboard.writeText(value);
      return true;
    } catch {
      // Where the clipboard API is refused, fall back to a selection the browser copies itself.
      const area = document.createElement('textarea');
      area.value = value;
      area.setAttribute('readonly', '');
      area.style.cssText = 'position:fixed;inset:0 auto auto 0;opacity:0';
      check.append(area);
      area.select();
      let done = false;
      try {
        done = document.execCommand('copy');
      } catch {
        done = false;
      }
      area.remove();
      return done;
    }
  }

  copyButton.addEventListener('click', async () => {
    if (await copyText(prompt)) {
      copyLabel.textContent = 'Copied';
      status.textContent = 'The prompt is on your clipboard. Now open an AI assistant.';
    } else {
      details.open = true;
      getSelection()?.selectAllChildren(promptBox);
      status.textContent = 'Your browser did not allow copying. The prompt is selected below: copy it from there.';
    }
  });

  $(check, 'data-check-close').addEventListener('click', () => check.close());
  // Clicking outside the sheet closes it, where closedby="any" is not supported.
  check.addEventListener('click', (e) => {
    if (e.target === check) check.close();
  });
</script>

<style>
  /* ——— The solving view: a plain page laid over the notes, flat like every page. ——— */

  .solve {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--paper);
    color: var(--ink);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .solve::backdrop { background: var(--paper); }
  .solve:focus { outline: none; }

  :global(html:has(dialog.solve[open])) { overflow: hidden; }

  @media (prefers-reduced-motion: no-preference) {
    .solve {
      opacity: 0;
      transition:
        opacity 160ms cubic-bezier(0.4, 0, 1, 1),
        overlay 160ms allow-discrete,
        display 160ms allow-discrete;
    }

    .solve[open] {
      opacity: 1;
      transition-duration: 320ms;
      transition-timing-function: var(--ease-out);
    }

    /* Opening, the plain page comes first, then its parts ink in one after another: where you
       are, the question, what you can do with it, and the way to the others. */
    .solve[open] :is(.solve-top, .solve-question, .solve-check, .solve-nav) {
      transition: opacity 520ms var(--ease-out);
    }

    .solve[open] .solve-top { transition-delay: 80ms; }
    .solve[open] .solve-question { transition-delay: 160ms; }
    .solve[open] .solve-check {
      transition:
        opacity 520ms var(--ease-out) 280ms,
        background-color 200ms var(--ease-out);
    }
    .solve[open] .solve-nav { transition-delay: 340ms; }

    @starting-style {
      .solve[open] { opacity: 0; }
      .solve[open] :is(.solve-top, .solve-question, .solve-check, .solve-nav) { opacity: 0; }
    }
  }

  .solve-frame {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    row-gap: clamp(1rem, 3vh, 1.75rem);
    height: 100%;
    max-width: 100rem;
    margin: 0 auto;
    padding: clamp(1rem, 3.5vh, 2rem) var(--gutter);
  }

  .solve-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .solve-where {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 1.25rem;
    font-weight: 400;
    font-size: 1rem;
    line-height: 1.4;
    color: var(--ink-2);
  }

  /* The section's numeral hangs, so a long title wraps beside it rather than under it. */
  .solve-section { display: flex; }

  .solve-section-n {
    flex: none;
    min-width: 1.5em;
    color: var(--red);
    font-variant-numeric: lining-nums;
  }

  /* Labels and the controls set as labels: CLOSE, PREVIOUS, NEXT. */
  .solve-label {
    padding: 0;
    border: 0;
    background: none;
    font-family: var(--face-text);
    font-size: 0.8125rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  button.solve-label { cursor: pointer; }
  button.solve-label:hover:not(:disabled) { color: var(--red); }
  .solve-close { flex: none; padding-block: 0.5rem; }

  /* The question, and with every question open, the rail of sections beside it. */
  .solve-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-height: 0;
  }

  .solve-sections { display: none; }

  @media (min-width: 960px) {
    /* The rail stands to the left of the question, as the contents stand to the left of the notes. */
    .solve[data-all] .solve-body {
      grid-template-columns: clamp(18rem, 27vw, 25rem) minmax(0, 1fr);
      gap: clamp(1.5rem, 3vw, 3rem);
    }

    .solve[data-all] .solve-sections {
      display: flex;
      grid-column: 1;
      grid-row: 1;
    }

    .solve[data-all] .solve-main { grid-column: 2; }
  }

  /* The question stands alone, larger than the notes, a little above the middle of the window. It
     scrolls in its own space when it is longer than the window. */
  .solve-main {
    min-height: 0;
    overflow-y: auto;
    scrollbar-width: none;
    width: 100%;
    max-width: calc(36em + var(--margin-col));
    margin: 0 auto;
    padding-block: clamp(3rem, 16vh, 9rem) 3rem;
  }

  .solve-main::-webkit-scrollbar { display: none; }

  /* The rail: its heading stands fixed above the list of sections, which scrolls on its own beneath
     it, so nothing passes behind the heading. It reads like the contents: each section's numeral and
     title, which open its first question, and under them the numerals of its questions, the one
     being solved in vermilion. */
  .solve-sections {
    flex-direction: column;
    align-self: start;
    max-height: 100%;
    min-height: 0;
  }

  .solve-sections-head {
    flex: none;
    padding-bottom: 0.6rem;
    font-family: var(--face-text);
    font-weight: 400;
    font-size: 1.125rem;
    line-height: 1.3;
    color: var(--ink);
  }

  .solve-sections-list {
    min-height: 0;
    margin: 0;
    padding: 0 0 1rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
  }

  .solve-sections-list::-webkit-scrollbar { display: none; }

  .solve-sections-list,
  .solve-sections :global(.solve-sec ol) { list-style: none; }

  .solve-sections :global(.solve-sec + .solve-sec) { margin-top: 0.5rem; }

  .solve-sections :global(.solve-sec-head) {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    width: 100%;
    padding: 0.35rem 0 0.15rem;
    border: 0;
    background: none;
    text-align: left;
    font-family: var(--face-text);
    font-size: 1rem;
    line-height: 1.35;
    color: var(--ink-2);
    cursor: pointer;
  }

  .solve-sections :global(.solve-sec-n) {
    font-variant-numeric: lining-nums;
    color: var(--ink-3);
  }

  .solve-sections :global(.solve-sec.is-current .solve-sec-head) { color: var(--ink); }
  .solve-sections :global(.solve-sec-head:hover),
  .solve-sections :global(.solve-sec-head:hover .solve-sec-n) { color: var(--red); }

