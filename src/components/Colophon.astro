---
import Name from './Name.astro';
---

<footer class="colophon">
  <p class="name"><Name /></p>
</footer>

<style>
  .colophon {
    max-width: 100rem;
    margin: clamp(2rem, 6svh, 6rem) auto 0;
    padding: 0 var(--gutter) clamp(1.25rem, 4svh, 2.5rem);
  }

  .name {
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-size: 0.8125rem;
    color: var(--ink-2);
  }

</style>
