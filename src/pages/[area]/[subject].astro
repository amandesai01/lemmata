---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Colophon from '../../components/Colophon.astro';
import { components } from '../../components/notes';
import { figures } from '../../components/notes/figures';
import { catalog } from '../../data/catalog';
import '../../styles/notes.css';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => {
    const [area, subject] = note.id.split('/');
    return { params: { area, subject }, props: { note } };
  });
}

const { note } = Astro.props;
const { title, description, abstract, area, figure } = note.data;
const { Content, headings } = await render(note);

const sections = headings.filter((h) => h.depth === 2);
const areaName = catalog.find((s) => s.id === area)!.name;
const Figure = figures[figure];
---

<Base title={`${title} · Lemmata`} description={description}>
  <SiteHeader />

  <main class="notes">
    <div class="opening-figure">
      <Figure />
    </div>

    <header class="title-block">
      <h1 data-vt style={`--vt: subject-${note.id.split('/')[1]}`}>{title}</h1>
      <dl class="facts">
        <dt>Area</dt>
        <dd><a href={`/#${area}`}>{areaName}</a></dd>
      </dl>
      <p class="abstract">{abstract}</p>
    </header>

    <nav class="contents" aria-labelledby="contents-heading">
      <h2 id="contents-heading">Contents</h2>
      <ol>
        {sections.map((s, i) => (
          <li>
            <a href={`#${s.slug}`} data-section={s.slug}>
              <span class="toc-num">{i + 1}</span>
              <span>{s.text}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <article class="prose">
      <Content components={components} />
    </article>
  </main>

  <Colophon />
</Base>

<script>
  // Mark the section being read in the contents: the last section whose heading has passed the top
  // fifth of the window, or the first while its heading is still in the upper part of the window.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('.contents a[data-section]')].map((a) => [a.dataset.section!, a]),
  );
  const headings = [...document.querySelectorAll<HTMLElement>('.prose h2[id]')];

  const mark = (id: string | null) => {
    links.forEach((a, key) => {
      if (key === id) a.setAttribute('aria-current', 'location');
      else a.removeAttribute('aria-current');
    });
  };

  const update = () => {
    const vh = window.innerHeight;
    const passed = headings.filter((h) => h.getBoundingClientRect().top <= vh * 0.15);
    const current = passed.at(-1) ?? (headings[0]?.getBoundingClientRect().top < vh * 0.4 ? headings[0] : null);
    mark(current?.id ?? null);
  };

  if (headings.length) {
    let queued = false;
    const schedule = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        update();
      });
    };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    update();
  }
</script>

<style>
  .notes {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'figure' 'head' 'contents' 'body';
    max-width: 100rem;
    margin-inline: auto;
    padding: clamp(1.5rem, 5vw, 2.5rem) var(--gutter) 0;
  }

  .opening-figure { grid-area: figure; }
  .title-block { grid-area: head; margin-top: clamp(2.5rem, 7vw, 3.5rem); }
  .contents { grid-area: contents; margin-top: 3rem; }
  .prose { grid-area: body; margin-top: clamp(3rem, 7vw, 4rem); }

  /* Title block */

  h1 {
    font-family: var(--face-display);
    font-weight: 400;
    font-size: clamp(2.75rem, 5vw, 4.75rem);
    line-height: 1;
    letter-spacing: -0.005em;
    text-wrap: balance;
    /* Shrink-wrapped, so the title arriving from the homepage lands on the words, not the full column. */
    width: fit-content;
  }

  .facts {
    display: grid;
    grid-template-columns: calc(var(--margin-col) + 0.5rem) minmax(0, 1fr);
    row-gap: 0.25rem;
    margin: 1.75rem 0 0;
    font-size: 1rem;
  }

  .facts dt {
    padding-top: 0.2rem;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .facts dd { margin: 0; color: var(--ink); }
  .facts a { text-decoration-color: var(--ink-3); }
  .facts a:hover { color: var(--red); text-decoration-color: var(--red); }

  .abstract {
    margin-top: 1.75rem;
    max-width: 34em;
    font-size: clamp(1.125rem, 1.4vw, 1.25rem);
    line-height: 1.5;
    text-wrap: pretty;
  }

  /* Contents */

  .contents h2 {
    font-weight: 400;
    font-size: 0.8125rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .contents a {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    padding-block: 0.3rem;
    font-size: 1rem;
    line-height: 1.35;
    color: var(--ink-2);
    text-decoration: none;
  }

  .toc-num {
    font-variant-numeric: lining-nums tabular-nums;
    color: var(--ink-3);
  }

  .contents a:hover { color: var(--red); }
  .contents a:hover span:last-child { text-decoration: underline; text-decoration-color: var(--red); }

  /* The section being read: full ink, its numeral in red. */
  .contents a[aria-current='location'] { color: var(--ink); }
  .contents a[aria-current='location'] .toc-num { color: var(--red); }

  @media (min-width: 960px) {
    /* Two columns. The left fifth holds the figure, its caption, then the contents rail;
       the rest holds the title and the text on one shared edge. */
    .notes {
      grid-template-columns: minmax(13rem, 1fr) minmax(0, 4fr);
      grid-template-rows: auto auto 1fr;
      grid-template-areas:
        'figure head'
        'figure body'
        'contents body';
      column-gap: clamp(2rem, 3vw, 3rem);
      padding-top: 0.25rem;
    }

    .opening-figure { padding-top: 2.5rem; }

    /* The column is too narrow for the caption's margin numeral: FIG. 1 sits above its text. */
    .opening-figure :global(.caption) {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0.5rem;
      font-size: 0.9375rem;
    }

    .opening-figure :global(.caption-text),
    .opening-figure :global(.readout) { grid-column: 1; }

    .title-block {
      align-self: start;
      margin-top: 2.5rem;
    }

    .title-block,
    .prose { padding-left: var(--margin-col); }

    .prose { max-width: calc(var(--margin-col) + 36em); }

    .contents,
    .prose { margin-top: clamp(3rem, 7svh, 4.5rem); }

    .contents {
      align-self: start;
      position: sticky;
      top: 2rem;
    }

    /* Fact labels hang in the margin column, as the figure numeral and section numerals do. */
    .facts {
      grid-template-columns: var(--margin-col) minmax(0, 1fr);
      margin-left: calc(-1 * var(--margin-col));
    }
  }
</style>
