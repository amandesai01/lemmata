---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Colophon from '../../components/Colophon.astro';
import { components } from '../../components/notes';
import { figures } from '../../components/notes/figures';
import { listStatements } from '../../components/notes/statements';
import StatementPeek from '../../components/notes/StatementPeek.astro';
import SolveView from '../../components/notes/SolveView.astro';
import { catalog } from '../../data/catalog';
import '../../styles/notes.css';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => {
    const [area, subject] = note.id.split('/');
    return { params: { area, subject }, props: { note } };
  });
}

const { note } = Astro.props;
const { title, description, area, figure } = note.data;
const { Content, headings } = await render(note);

const sections = headings.filter((h) => h.depth === 2);
const areaName = catalog.find((s) => s.id === area)!.name;
const Figure = figures[figure];
const statements = listStatements(note.body ?? '', note.id);
// Where the section number changes (1.4 → 2.1), the list leaves a little space.
const opensSection = (i: number) => i > 0 && statements[i].n.split('.')[0] !== statements[i - 1].n.split('.')[0];
---

<Base title={`${title} · Lemmata`} description={description}>
  <SiteHeader />

  <main class="notes">
    <div class="opening-figure">
      <Figure />
    </div>

    <header class="title-block">
      <h1 data-vt style={`--vt: subject-${note.id.split('/')[1]}`}>{title}</h1>
      <dl class="facts">
        <dt>Area</dt>
        <dd><a href={`/#${area}`}>{areaName}</a></dd>
      </dl>
    </header>

    <nav class="contents" aria-labelledby="contents-heading">
      <h2 id="contents-heading">Contents</h2>
      <ol>
        {sections.map((s, i) => (
          <li>
            <a href={`#${s.slug}`} data-section={s.slug}>
              <span class="toc-num">{i + 1}</span>
              <span>{s.text}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <article class="prose">
      <Content components={components} />
    </article>

    {statements.length > 0 && (
      <nav class="statements" aria-labelledby="statements-heading">
        <h2 id="statements-heading">Statements</h2>
        <ol>
          {statements.map((s, i) => (
            <li class:list={{ 'opens-section': opensSection(i) }}>
              <a href={`#${s.id}`} data-statement={s.id}>
                <span class="st-label">{s.kind} {s.n}</span>
                <span class="st-title" set:html={s.title} />
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )}
  </main>

  <StatementPeek />
  <SolveView />

  <Colophon />
</Base>

<script>
  // Mark where the reader is: in the contents, the last section whose heading has passed the top
  // fifth of the window, or the first while its heading is still in the upper part of the window;
  // in the statements, the last statement to pass the same line, kept in view in its list.
  const linksBy = (selector: string, key: string) =>
    new Map([...document.querySelectorAll<HTMLAnchorElement>(selector)].map((a) => [a.dataset[key]!, a]));
  const sectionLinks = linksBy('.contents a[data-section]', 'section');
  const statementLinks = linksBy('.statements a[data-statement]', 'statement');
  const statementList = document.querySelector<HTMLElement>('.statements');

  const headings = [...document.querySelectorAll<HTMLElement>('.prose h2[id]')];
  const statements = [...statementLinks.keys()].map((id) => document.getElementById(id)!).filter(Boolean);

  const mark = (links: Map<string, HTMLAnchorElement>, id: string | null) => {
    links.forEach((a, key) => {
      if (key === id) a.setAttribute('aria-current', 'location');
      else a.removeAttribute('aria-current');
    });
  };

  const lastPassed = (els: HTMLElement[], line: number) => els.filter((el) => el.getBoundingClientRect().top <= line).at(-1);

  const update = () => {
    const vh = window.innerHeight;
    const section = lastPassed(headings, vh * 0.15) ?? (headings[0]?.getBoundingClientRect().top < vh * 0.4 ? headings[0] : null);
    mark(sectionLinks, section?.id ?? null);

    const statement = lastPassed(statements, vh * 0.15);
    mark(statementLinks, statement?.id ?? null);

    // Scroll the list itself, never the page, so the marked statement stays in sight.
    const link = statement && statementLinks.get(statement.id);
    if (link && statementList && statementList.scrollHeight > statementList.clientHeight) {
      const top = link.offsetTop;
      const bottom = top + link.offsetHeight;
      const margin = statementList.clientHeight * 0.25;
      if (top < statementList.scrollTop + margin) statementList.scrollTop = top - margin;
      else if (bottom > statementList.scrollTop + statementList.clientHeight - margin)
        statementList.scrollTop = bottom - statementList.clientHeight + margin;
    }
  };

  if (headings.length) {
    let queued = false;
    const schedule = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        update();
      });
    };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    update();
  }
</script>

<style>
  .notes {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'figure' 'head' 'contents' 'body';
    max-width: 100rem;
    margin-inline: auto;
    padding: clamp(1.5rem, 5vw, 2.5rem) var(--gutter) 0;
  }

  .opening-figure { grid-area: figure; }
  .title-block { grid-area: head; margin-top: clamp(2.5rem, 7vw, 3.5rem); }
  .contents { grid-area: contents; margin-top: 3rem; }
  .prose { grid-area: body; margin-top: clamp(3rem, 7vw, 4rem); }
  /* Only where there is room for a third column. */
  .statements { grid-area: index; display: none; }

  /* Title block */

  h1 {
    font-family: var(--face-display);
    font-weight: 400;
    font-size: clamp(2.75rem, 5vw, 4.75rem);
    line-height: 1;
    letter-spacing: -0.005em;
    text-wrap: balance;
    /* Shrink-wrapped, so the title arriving from the homepage lands on the words, not the full column. */
    width: fit-content;
  }

  .facts {
    display: grid;
    grid-template-columns: calc(var(--margin-col) + 0.5rem) minmax(0, 1fr);
    row-gap: 0.25rem;
    margin: 1.75rem 0 0;
    font-size: 1rem;
  }

  .facts dt {
    padding-top: 0.2rem;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .facts dd { margin: 0; color: var(--ink); }
  .facts a { text-decoration-color: var(--ink-3); }
  .facts a:hover { color: var(--red); text-decoration-color: var(--red); }

  /* Contents */

  .contents h2 {
    font-weight: 400;
    font-size: 0.8125rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .contents a {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    padding-block: 0.3rem;
    font-size: 1rem;
    line-height: 1.35;
    color: var(--ink-2);
    text-decoration: none;
  }

  .toc-num {
    font-variant-numeric: lining-nums tabular-nums;
    color: var(--ink-3);
  }

  .contents a:hover { color: var(--red); }
  .contents a:hover span:last-child { text-decoration: underline; text-decoration-color: var(--red); }

  /* The section being read: numeral and title in red. */
  .contents a[aria-current='location'],
  .contents a[aria-current='location'] .toc-num { color: var(--red); }

  /* Statements: every definition, result and example, each opening a quick look. */

  .statements h2 {
    font-weight: 400;
    font-size: 0.8125rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .statements li.opens-section { margin-top: 0.75rem; }

  .statements a {
    display: block;
    padding-block: 0.3rem;
    line-height: 1.35;
    color: var(--ink-2);
    text-decoration: none;
  }

  .st-label {
    display: block;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .st-title {
    display: block;
    font-family: var(--face-math);
    font-size: 0.9375rem;
    text-wrap: pretty;
  }

  .st-title :global(em),
  .st-title :global(dfn) { font-style: italic; }
  .st-title :global(sub),
  .st-title :global(sup) { font-size: 0.72em; line-height: 0; }

  .statements a:hover .st-label,
  .statements a:hover .st-title { color: var(--red); }

  /* The statement being read: full ink, its label in red. */
  .statements a[aria-current='location'] .st-title { color: var(--ink); }
  .statements a[aria-current='location'] .st-label { color: var(--red); }

  @media (min-width: 960px) {
    /* Two columns. The left fifth holds the figure, its caption, then the contents rail;
       the rest holds the title and the text on one shared edge. */
    .notes {
      grid-template-columns: minmax(13rem, 1fr) minmax(0, 4fr);
      grid-template-rows: auto auto 1fr;
      grid-template-areas:
        'figure head'
        'figure body'
        'contents body';
      column-gap: clamp(2rem, 3vw, 3rem);
      padding-top: 0.25rem;
    }

    .opening-figure { padding-top: 2.5rem; }

    /* The column is too narrow for the caption's margin numeral: FIG. 1 sits above its text. */
    .opening-figure :global(.caption) {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0.5rem;
      font-size: 0.9375rem;
    }

    .opening-figure :global(.caption-text),
    .opening-figure :global(.readout) { grid-column: 1; }

    .title-block {
      align-self: start;
      margin-top: 2.5rem;
    }

    .title-block,
    .prose { padding-left: var(--margin-col); }

    .prose { max-width: calc(var(--margin-col) + 36em); }

    .contents,
    .prose { margin-top: clamp(3rem, 7svh, 4.5rem); }

    .contents {
      align-self: start;
      position: sticky;
      top: 2rem;
    }

    /* Fact labels hang in the margin column, as the figure numeral and section numerals do. */
    .facts {
      grid-template-columns: var(--margin-col) minmax(0, 1fr);
      margin-left: calc(-1 * var(--margin-col));
    }
  }

  @media (min-width: 1280px) {
    /* A third column, as wide as the figure rail, holds the statements. The rail keeps its fifth. */
    .notes {
      grid-template-columns: minmax(13rem, 1fr) minmax(0, 3fr) minmax(13rem, 1fr);
      grid-template-areas:
        'figure head index'
        'figure body index'
        'contents body index';
    }

    .statements {
      display: block;
      align-self: start;
      position: sticky;
      top: 2rem;
      max-height: calc(100svh - 4rem);
      margin-top: 2.5rem;
      overflow-y: auto;
      overscroll-behavior: contain;
      /* Scrolls by wheel and follows the reader, without a bar of its own. */
      scrollbar-width: none;
    }

    .statements::-webkit-scrollbar { display: none; }
  }
</style>
